#: eye-extended@als.kz/extension.js:1198 eye-extended@als.kz/extension.js:1260
#: eye-extended@als.kz/prefs.js:226
msgid "Pointer trail"
msgstr "Aanwijzerspoor"

#: eye-extended@als.kz/extension.js:1204 eye-extended@als.kz/prefs.js:163
msgid "Mouse indicator"
msgstr "Muisindicator"

#: eye-extended@als.kz/extension.js:1213 eye-extended@als.kz/prefs.js:276
msgid "Cat"
msgstr "Kat"

#: eye-extended@als.kz/extension.js:1223
msgid "Settings"
msgstr "Instellingen"

#: eye-extended@als.kz/extension.js:1261
msgid "Pointer trail (hold Ctrl)"
msgstr "Aanwijzerspoor (houd Ctrl ingedrukt)"

#: eye-extended@als.kz/prefs.js:58
msgid "Reset to defaults"
msgstr "Standaardwaarden herstellen"

#: eye-extended@als.kz/prefs.js:65
msgid "Support the project on Ko-fi"
msgstr "Steun het project op Ko-fi"

#: eye-extended@als.kz/prefs.js:74
msgid "Reset all settings?"
msgstr "Alle instellingen herstellen?"

#: eye-extended@als.kz/prefs.js:75
msgid "All settings of the extension will be returned to their default values."
msgstr "Alle instellingen van de extensie worden teruggezet naar de standaardwaarden."

#: eye-extended@als.kz/prefs.js:81
msgid "Cancel"
msgstr "Annuleren"

#: eye-extended@als.kz/prefs.js:82
msgid "Reset"
msgstr "Herstellen"

#: eye-extended@als.kz/prefs.js:101
msgid "Eye"
msgstr "Oog"

#: eye-extended@als.kz/prefs.js:107 eye-extended@als.kz/prefs.js:175
#: eye-extended@als.kz/prefs.js:248
msgid "Shape"
msgstr "Vorm"

#: eye-extended@als.kz/prefs.js:108
msgid "Round"
msgstr "Rond"

#: eye-extended@als.kz/prefs.js:109
msgid "Eyelid"
msgstr "Met oogleden"

#: eye-extended@als.kz/prefs.js:110
msgid "Cat eye"
msgstr "Kattenoog"

#: eye-extended@als.kz/prefs.js:111
msgid "Pair of eyes"
msgstr "Twee ogen"

#: eye-extended@als.kz/prefs.js:112
msgid "Cartoon"
msgstr "Cartoon"

#: eye-extended@als.kz/prefs.js:113
msgid "Lens"
msgstr "Lens"

#: eye-extended@als.kz/prefs.js:114
msgid "Crosshair"
msgstr "Vizier"

#: eye-extended@als.kz/prefs.js:116
msgid "Place in the panel"
msgstr "Plaats in het paneel"

#: eye-extended@als.kz/prefs.js:117
msgid "Left"
msgstr "Links"

#: eye-extended@als.kz/prefs.js:118
msgid "Center"
msgstr "Midden"

#: eye-extended@als.kz/prefs.js:119
msgid "Right"
msgstr "Rechts"

#: eye-extended@als.kz/prefs.js:120
msgid "Part of the top panel the eye is shown in"
msgstr "Deel van het bovenpaneel waarin het oog wordt getoond"

#: eye-extended@als.kz/prefs.js:122
msgid "Order in the panel"
msgstr "Volgorde in het paneel"

#: eye-extended@als.kz/prefs.js:123
msgid "Order among the other icons in the same part of the panel"
msgstr "Volgorde tussen de andere pictogrammen in hetzelfde deel van het paneel"

#: eye-extended@als.kz/prefs.js:125 eye-extended@als.kz/prefs.js:178
#: eye-extended@als.kz/prefs.js:252 eye-extended@als.kz/prefs.js:288
msgid "Size"
msgstr "Grootte"

#: eye-extended@als.kz/prefs.js:126
msgid "Eye height in pixels"
msgstr "Hoogte van het oog in pixels"

#: eye-extended@als.kz/prefs.js:128 eye-extended@als.kz/prefs.js:255
msgid "Line thickness"
msgstr "Lijndikte"

#: eye-extended@als.kz/prefs.js:129
msgid "Width of the eye outline"
msgstr "Breedte van de omtrek van het oog"

#: eye-extended@als.kz/prefs.js:131
msgid "Margin"
msgstr "Marge"

#: eye-extended@als.kz/prefs.js:132
msgid "Empty space on both sides of the eye"
msgstr "Lege ruimte aan beide kanten van het oog"

#: eye-extended@als.kz/prefs.js:134 eye-extended@als.kz/prefs.js:184
msgid "Refresh interval (ms)"
msgstr "Verversingsinterval (ms)"

#: eye-extended@als.kz/prefs.js:135 eye-extended@als.kz/prefs.js:185
msgid "Lower is smoother, higher uses less CPU"
msgstr "Lager is vloeiender, hoger belast de processor minder"

#: eye-extended@als.kz/prefs.js:138
msgid "Behavior"
msgstr "Gedrag"

#: eye-extended@als.kz/prefs.js:139
msgid "What the eye does besides following the cursor"
msgstr "Wat het oog doet naast het volgen van de cursor"

#: eye-extended@als.kz/prefs.js:144
msgid "Blink"
msgstr "Knipperen"

#: eye-extended@als.kz/prefs.js:145
msgid "The eye blinks from time to time"
msgstr "Het oog knippert af en toe"

#: eye-extended@als.kz/prefs.js:147
msgid "Blink on click"
msgstr "Knipperen bij klik"

#: eye-extended@als.kz/prefs.js:148
msgid "The eye blinks when a mouse button is pressed"
msgstr "Het oog knippert wanneer een muisknop wordt ingedrukt"

#: eye-extended@als.kz/prefs.js:150
msgid "Pupil reacts to the cursor"
msgstr "Pupil reageert op de cursor"

#: eye-extended@als.kz/prefs.js:151
msgid "The pupil grows as the cursor comes closer to the eye"
msgstr "De pupil wordt groter naarmate de cursor dichter bij het oog komt"

#: eye-extended@als.kz/prefs.js:153
msgid "Fall asleep"
msgstr "In slaap vallen"

#: eye-extended@als.kz/prefs.js:154
msgid "The eye half closes when the mouse has not moved for 30 seconds"
msgstr "Het oog sluit half als de muis 30 seconden niet heeft bewogen"

#: eye-extended@als.kz/prefs.js:167
msgid "Turn it on from the menu of the eye"
msgstr "Schakel in via het menu van het oog"

#: eye-extended@als.kz/prefs.js:172
msgid "Show the shape around the cursor"
msgstr "Vorm rond de cursor tonen"

#: eye-extended@als.kz/prefs.js:173
msgid "When it is off, only clicks are highlighted"
msgstr "Indien uit, worden alleen klikken gemarkeerd"

#: eye-extended@als.kz/prefs.js:176
msgid "One of the 19 shapes"
msgstr "Een van de 19 vormen"

#: eye-extended@als.kz/prefs.js:179
msgid "Shape size in pixels"
msgstr "Grootte van de vorm in pixels"

#: eye-extended@als.kz/prefs.js:181
msgid "Opacity"
msgstr "Dekking"

#: eye-extended@als.kz/prefs.js:182
msgid "From 1 (almost invisible) to 255 (opaque)"
msgstr "Van 1 (bijna onzichtbaar) tot 255 (dekkend)"

#: eye-extended@als.kz/prefs.js:187 eye-extended@als.kz/prefs.js:260
msgid "Color"
msgstr "Kleur"

#: eye-extended@als.kz/prefs.js:188
msgid "Shape color when no button is pressed"
msgstr "Kleur van de vorm als er geen knop is ingedrukt"

#: eye-extended@als.kz/prefs.js:190
msgid "Color the eye"
msgstr "Oog kleuren"

#: eye-extended@als.kz/prefs.js:191
msgid "The eye in the panel takes the color of the indicator while it is on"
msgstr "Het oog in het paneel krijgt de kleur van de indicator zolang die aan staat"

#: eye-extended@als.kz/prefs.js:194
msgid "Clicks"
msgstr "Klikken"

#: eye-extended@als.kz/prefs.js:195
msgid "The shape changes color and flashes on click"
msgstr "De vorm verandert van kleur en licht op bij een klik"

#: eye-extended@als.kz/prefs.js:199
msgid "Highlight left clicks"
msgstr "Linkerklikken markeren"

#: eye-extended@als.kz/prefs.js:200
msgid "Highlight middle clicks"
msgstr "Middelklikken markeren"

#: eye-extended@als.kz/prefs.js:201
msgid "Highlight right clicks"
msgstr "Rechterklikken markeren"

#: eye-extended@als.kz/prefs.js:205
msgid "Click colors"
msgstr "Klikkleuren"

#: eye-extended@als.kz/prefs.js:206
msgid "Left, middle, right"
msgstr "Links, midden, rechts"

#: eye-extended@als.kz/prefs.js:209
msgid "Left click"
msgstr "Linkerklik"

#: eye-extended@als.kz/prefs.js:210
msgid "Middle click"
msgstr "Middelklik"

#: eye-extended@als.kz/prefs.js:211
msgid "Right click"
msgstr "Rechterklik"

#: eye-extended@als.kz/prefs.js:230
msgid "Animation that follows the mouse"
msgstr "Animatie die de muis volgt"

#: eye-extended@als.kz/prefs.js:235 eye-extended@als.kz/prefs.js:285
msgid "Enable"
msgstr "Inschakelen"

#: eye-extended@als.kz/prefs.js:236 eye-extended@als.kz/prefs.js:286
msgid "The same switch is in the menu of the eye"
msgstr "Dezelfde schakelaar staat in het menu van het oog"

#: eye-extended@als.kz/prefs.js:237
msgid "Show"
msgstr "Tonen"

#: eye-extended@als.kz/prefs.js:238
msgid "While Ctrl is held"
msgstr "Terwijl Ctrl ingedrukt is"

#: eye-extended@als.kz/prefs.js:239
msgid "Always"
msgstr "Altijd"

#: eye-extended@als.kz/prefs.js:240
msgid "When the trail is drawn as the mouse moves"
msgstr "Wanneer het spoor wordt getekend als de muis beweegt"

#: eye-extended@als.kz/prefs.js:241
msgid "Animation"
msgstr "Animatie"

#: eye-extended@als.kz/prefs.js:242
msgid "Water ripples"
msgstr "Rimpelingen"

#: eye-extended@als.kz/prefs.js:243
msgid "Pointer line"
msgstr "Aanwijzerlijn"

#: eye-extended@als.kz/prefs.js:244
msgid "Comet tail"
msgstr "Komeetstaart"

#: eye-extended@als.kz/prefs.js:245
msgid "Sparkles"
msgstr "Vonken"

#: eye-extended@als.kz/prefs.js:249
msgid "0 is a plain ring or dot, 1–19 are the mouse indicator shapes"
msgstr "0 is een eenvoudige ring of stip, 1–19 zijn de vormen van de muisindicator"

#: eye-extended@als.kz/prefs.js:253
msgid "Size of each piece of the trail in pixels"
msgstr "Grootte van elk deel van het spoor in pixels"

#: eye-extended@als.kz/prefs.js:256
msgid "Width of the ring outline and of the pointer line"
msgstr "Breedte van de ringomtrek en van de aanwijzerlijn"

#: eye-extended@als.kz/prefs.js:258
msgid "Duration (ms)"
msgstr "Duur (ms)"

#: eye-extended@als.kz/prefs.js:259
msgid "How long the trail takes to fade away"
msgstr "Hoe lang het spoor erover doet om te vervagen"

#: eye-extended@als.kz/prefs.js:280
msgid "A cat that runs after the cursor, grooms itself and falls asleep next to it"
msgstr "Een kat die achter de cursor aan rent, zich wast en ernaast in slaap valt"

#: eye-extended@als.kz/prefs.js:289
msgid "Size of the cat in pixels"
msgstr "Grootte van de kat in pixels"

#: eye-extended@als.kz/prefs.js:291
msgid "Distance to the cursor"
msgstr "Afstand tot de cursor"

#: eye-extended@als.kz/prefs.js:292
msgid "How far from the cursor the cat stops, in pixels. If it is small, the cursor ends up on the cat and clicks go to it."
msgstr "Hoe ver van de cursor de kat stopt, in pixels. Bij een kleine waarde staat de cursor op de kat en gaan klikken naar de kat."

#: eye-extended@als.kz/prefs.js:295
msgid "How to play"
msgstr "Zo speel je"

#: eye-extended@als.kz/prefs.js:299
msgid "Click the cat"
msgstr "Klik op de kat"

#: eye-extended@als.kz/prefs.js:299
msgid "It swipes a paw, tumbles, rolls over or jumps"
msgstr "Ze haalt uit met een poot, tuimelt, rolt om of springt"

#: eye-extended@als.kz/prefs.js:300
msgid "Hold the left button on the cat"
msgstr "Houd de linkerknop op de kat ingedrukt"

#: eye-extended@als.kz/prefs.js:300
msgid "Pick it up by the scruff, carry it and throw it"
msgstr "Til haar op bij het nekvel, draag haar en gooi haar"

#: eye-extended@als.kz/prefs.js:301
msgid "Shake the cursor next to the cat"
msgstr "Schud de cursor naast de kat"

#: eye-extended@als.kz/prefs.js:301
msgid "It runs away, sulks and avoids the cursor for a minute"
msgstr "Ze rent weg, mokt en ontwijkt de cursor een minuut lang"
